# ==============================================================================
# WorkFlowX Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit the actual .env file with production credentials to Git!

# Environment mode: 'development', 'test', or 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_URL=http://localhost:4000

# PostgreSQL Connection String (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/workflowx_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/workflowx_test?schema=public"

# Session & Security Settings
SESSION_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
SESSION_COOKIE_NAME=workflowx_session
SESSION_MAX_AGE_HOURS=24
SESSION_SECURE_COOKIE=false # Set to true in production (requires HTTPS)
SESSION_SAME_SITE=lax       # 'lax' or 'none' (use 'none' only with HTTPS cross-domain)

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Development Recovery Mode
# When true, forgot-password logs a recovery token to console in development
ENABLE_DEV_PASSWORD_RECOVERY=true

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="WorkFlowX"
NEXT_PUBLIC_APP_URL=http://localhost:3000

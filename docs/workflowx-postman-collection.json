{
  "info": {
    "name": "WorkFlowX API v1 Collection",
    "description": "Postman-compatible REST collection for WorkFlowX - Secure Team Task & Risk Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Chen\",\n  \"email\": \"alex.lead@workflowx.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.lead@workflowx.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "List Teams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/teams"
          }
        },
        {
          "name": "Create Team",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Core Platform Engineering\",\n  \"description\": \"Primary team workspace\"\n}"
            },
            "url": "{{baseUrl}}/teams"
          }
        },
        {
          "name": "Get Team Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/teams/{{teamId}}"
          }
        },
        {
          "name": "Invite Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"colleague@team.com\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": "{{baseUrl}}/teams/{{teamId}}/members"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects?teamId={{teamId}}"
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{teamId}}\",\n  \"name\": \"WorkFlowX SaaS Platform v1.0\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/projects"
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}"
          }
        }
      ]
    },
    {
      "name": "Tasks & Dependencies",
      "item": [
        {
          "name": "List Tasks with Risk",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks?projectId={{projectId}}"
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Implement Directed Dependency Graph\",\n  \"status\": \"TODO\",\n  \"priority\": \"HIGH\",\n  \"estimatedHours\": 12\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "Add Prerequisite Dependency",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"predecessorTaskId\": \"{{predecessorTaskId}}\"\n}"
            },
            "url": "{{baseUrl}}/tasks/{{successorTaskId}}/dependencies"
          }
        },
        {
          "name": "Post Task Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Dependency cycle detection tested and working.\"\n}"
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
          }
        }
      ]
    },
    {
      "name": "Dashboard & Metrics",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/metrics?teamId={{teamId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    }
  ]
}
